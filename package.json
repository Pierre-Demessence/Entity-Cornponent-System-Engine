{
  "name": "@pierre/ecs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Project-agnostic Entity-Component-System primitives (stores, queries, spatial index, templates, scheduler, event bus).",
  "license": "MIT",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./world": "./src/world.ts",
    "./component-store": "./src/component-store.ts",
    "./spatial-structure": "./src/spatial-structure.ts",
    "./query": "./src/query.ts",
    "./template": "./src/template.ts",
    "./event-bus": "./src/event-bus.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./scheduler": "./src/scheduler.ts",
    "./tick-source": "./src/tick-source.ts",
    "./tick-runner": "./src/tick-runner.ts",
    "./input-source": "./src/input-source.ts",
    "./audio-provider": "./src/audio-provider.ts",
    "./renderer": "./src/renderer.ts",
    "./entity-id": "./src/entity-id.ts",
    "./validation": "./src/validation.ts",
    "./test-utils": "./src/test-utils.ts",
    "./modules/*": "./src/modules/*/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && astro sync --root website && tsc -p website/tsconfig.json --noEmit",
    "typecheck:examples": "npm exec --workspaces -- tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "jiti scripts/engine-api.gen.ts",
    "docs:usage": "jiti scripts/engine-usage.gen.ts",
    "docs:site": "jiti scripts/manual.gen.ts && astro build --root website",
    "docs:dev": "jiti scripts/manual.gen.ts && astro dev --root website",
    "docs:manual": "jiti scripts/manual.gen.ts",
    "prepare": "husky || true"
  },
  "workspaces": [
    "examples/*"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@astrojs/starlight": "^0.42.2",
    "@types/node": "^22.20.3",
    "astro": "^7.3.3",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{yml,yaml}": "eslint --fix"
  }
}
